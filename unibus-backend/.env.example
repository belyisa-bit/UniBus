# Exemplos: Spring Boot lê variáveis do processo, não carrega este arquivo sozinho.
# Configure estas variáveis na IDE, terminal ou painel da hospedagem.
SPRING_PROFILES_ACTIVE=local
PORT=8081
JWT_EXPIRATION_MS=86400000
UNIBUS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para produção: SPRING_PROFILES_ACTIVE=render e valores reais no painel da Render.
# Gere uma chave Base64 aleatória de pelo menos 32 bytes. Nunca a versione.
# UNIBUS_JWT_SECRET=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
